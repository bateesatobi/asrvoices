# Environment Variables for A-Voices React App
# Copy this file to .env and fill in the real values — never commit .env to git

# ─── API ───────────────────────────────────────────────────────────────────────
REACT_APP_API_URL=https://api.phosaico.com
REACT_APP_AGENTS_API_URL=https://phosconversation.onrender.com

# ─── Stripe ────────────────────────────────────────────────────────────────────
# Use pk_test_... for development, pk_live_... for production
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ─── Firebase ──────────────────────────────────────────────────────────────────
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id
REACT_APP_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Build ─────────────────────────────────────────────────────────────────────
CI=false
